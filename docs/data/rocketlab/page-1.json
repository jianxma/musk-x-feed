    {
      "id": "2112345583319208037",
      "author": "rocketlab",
      "author_name": "Rocket Lab",
      "author_avatar": "https://pbs.twimg.com/profile_images/1494443717452709900/Y7Lg2mm__200x200.jpg",
      "author_verified": true,
      "author_verified_type": "organization",
      "created_at_utc": "2026-10-20T00:50:07.000Z",
      "created_at_shanghai": "2026-10-20 08:50:07",
      "type": "原文",
      "type_label": "原文",
      "text": "Production of the new carbon composite forward dome for Neutron’s Stage 1 propellant tank is underway.\n\nOur automated fiber placement (AFP) machine follows a computer-controlled course to lay down thousands of strands of carbon fiber - each thinner than a human hair - at speeds of up to 100 meters per minute to create Stage 1’s structures on custom molds.\n\nOnce the AFP machine is finished with the new forward dome it will be rolled out, inspected, then prepared for the curing process to harden the carbon composite.",
      "quote": null,
      "retweet": null,
      "reply_to": "",
      "engagement": {
        "bookmarks": 2,
        "likes": 74,
        "quotes": 3,
        "replies": 5,
        "retweets": 11,
        "views": 2725
      },
