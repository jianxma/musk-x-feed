    {
      "id": "2113376737358999883",
      "author": "rocketlab",
      "author_name": "Rocket Lab",
      "author_avatar": "https://pbs.twimg.com/profile_images/1494443717452709900/Y7Lg2mm__200x200.jpg",
      "author_verified": true,
      "author_verified_type": "organization",
      "created_at_utc": "2026-10-22T21:07:33.000Z",
      "created_at_shanghai": "2026-10-23 05:07:33",
      "type": "原文",
      "type_label": "原文",
      "text": "High cadence launch needs high cadence testing. With more than 100 launches in backlog (and counting), we're building a new state-of-the-art test facility to accelerate static fire stack testing for Electron and HASTE rockets.\n\nCheck out the new test pad underway within our Propulsion Test Complex 🧵👇",
      "quote": null,
