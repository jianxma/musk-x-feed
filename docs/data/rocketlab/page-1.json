    {
      "id": "2121322099679879173",
      "author": "rocketlab",
      "author_name": "Rocket Lab",
      "author_avatar": "https://pbs.twimg.com/profile_images/1494443717452709900/Y7Lg2mm__200x200.jpg",
      "author_verified": true,
      "author_verified_type": "organization",
      "created_at_utc": "2026-11-13T19:19:35.000Z",
      "created_at_shanghai": "2026-11-14 03:19:35",
      "type": "原文",
      "type_label": "原文",
      "text": "To launch a lot of rockets, you need to build a lot of rockets.\n\nOur factory is currently producing Electron at a rate of one rocket every 8 days.\n\nFrom single layers of carbon composite, to firing 3D-printed Rutherford engines multiple times before flight - every step requires precision and paranoia.\n\nThis is Electron's journey from production to the pad.",
      "quote": null,
      "retweet": null,
      "reply_to": "",
      "engagement": {
        "bookmarks": 10,
        "likes": 163,
        "quotes": 3,
        "replies": 3,
        "retweets": 19,
        "views": 5535
      },
      "url": "https://x.com/rocketlab/status/2121322099679879173",
      "images": [
        "https://pbs.twimg.com/amplify_video_thumb/2121313499213443072/img/uh4d5GqIKdCDONBZ.jpg"
      ],
      "media": [
        {
          "type": "video",
