    {
      "id": "2112642987394224408",
      "author": "rocketlab",
      "author_name": "Rocket Lab",
      "author_avatar": "https://pbs.twimg.com/profile_images/1494443717452709900/Y7Lg2mm__200x200.jpg",
      "author_verified": true,
      "author_verified_type": "organization",
      "created_at_utc": "2026-10-20T20:31:53.000Z",
      "created_at_shanghai": "2026-10-21 04:31:53",
      "type": "原文",
      "type_label": "原文",
      "text": "The first multi-spacecraft science mission to Mars is about to make its big move.\n\nNext month, Blue and Gold – the twin spacecraft we built for @NASA and @ucbssl – will swing close past Earth and each fire their main engine in a single, continuous burn, using Earth's gravity to amplify the burn as they set course for Mars. It's a maneuver that's never been successfully done before.\n\nOur mission ops team is in full rehearsal mode for @escapade_mars' trans-Mars injection.\n\nLearn more about ESCAPADE: https://rocketlabcorp.com/missions/escapade/",
      "quote": null,
      "retweet": null,
      "reply_to": "",
      "engagement": {
        "bookmarks": 20,
        "likes": 830,
        "quotes": 8,
        "replies": 20,
        "retweets": 102,
        "views": 22503
      },
