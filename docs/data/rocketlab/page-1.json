      "images": [
        "https://pbs.twimg.com/amplify_video_thumb/2112345432504598528/img/jEIwygNx7J_iPXew.jpg"
      ],
      "media": [
        {
          "type": "video",
          "url": "https://video.twimg.com/amplify_video/2112345432504598528/vid/avc1/3840x2160/yB2GJxWKnV_p40Oz.mp4?tag=29",
          "thumbnail_url": "https://pbs.twimg.com/amplify_video_thumb/2112345432504598528/img/jEIwygNx7J_iPXew.jpg",
          "width": 3840,
