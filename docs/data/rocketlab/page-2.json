    {
      "id": "2117342418723069984",
      "author": "rocketlab",
      "author_name": "Rocket Lab",
      "author_avatar": "https://pbs.twimg.com/profile_images/1494443717452709900/Y7Lg2mm__200x200.jpg",
      "author_verified": true,
      "author_verified_type": "organization",
      "created_at_utc": "2026-11-02T19:45:45.000Z",
      "created_at_shanghai": "2026-11-03 03:45:45",
      "type": "引用",
      "type_label": "引用",
      "text": "Strengthening national security in space relies on responsive launch and reliable spacecraft. We're proud to deliver both.🛰️🚀\n\nLooking forward to Brad Clevenger, who leads Space Systems work at Rocket Lab, joining @SenKevinCramer at this year’s Space Operations Summit in Grand Forks. Thank you, Senator Cramer, for the invitation!",
      "quote": {
        "author": "SenKevinCramer",
        "avatar": "https://pbs.twimg.com/profile_images/1090267977675460610/nQWIQ0ot_200x200.jpg",
        "created_at_shanghai": "2026-11-02 23:49:15",
        "created_at_utc": "2026-11-02T15:49:15.000Z",
        "id": "2117282902224298182",
        "images": [],
        "media": [],
        "name": "Senator Kevin Cramer",
        "text": "Companies like @RocketLab are playing an important role in strengthening our national security in space. And with more than two decades of experience in satellite missions and space technology, Brad Clevenger has a great perspective on where this industry is headed and the incredible advancements happening across the sector. I’m really honored he’s accepted my invitation to join me in Grand Forks for this year’s Space Operations Summit, and I’m looking forward to our conversation.\n\nRead more about Rocket Lab USA and President Brad Clevenger:\nhttps://www.cramer.senate.gov/news/press-releases/cramer-announces-und-space-operations-summit-guest",
        "url": "https://x.com/SenKevinCramer/status/2117282902224298182",
        "verified": true,
        "verified_type": "government"
      },
      "retweet": null,
      "reply_to": "",
      "engagement": {
        "bookmarks": 7,
        "likes": 589,
        "quotes": 3,
        "replies": 6,
        "retweets": 47,
        "views": 26907
      },
      "url": "https://x.com/rocketlab/status/2117342418723069984",
      "images": [],
      "media": [],
      "enriched": true
