    {
      "id": "2118702546462384325",
      "author": "evavlaar",
      "author_name": "Eva Vlaardingerbroek",
      "author_avatar": "https://pbs.twimg.com/profile_images/2076271674702405632/DfLkN7BC_200x200.jpg",
      "author_verified": true,
      "author_verified_type": "individual",
      "created_at_utc": "2026-11-06T13:50:25.000Z",
      "created_at_shanghai": "2026-11-06 21:50:25",
      "type": "引用",
      "type_label": "引用",
      "text": "Thank you, @RupertLowe10, for raising awareness of this outrageous two-tier system.\n\nThe British public deserves to know exactly who this government is letting in and who it’s keeping out.\n\nLet’s see if the @ukhomeoffice will grow a pair and care to comment.",
      "quote": {
        "author": "RupertLowe10",
        "avatar": "https://pbs.twimg.com/profile_images/1939641852077948928/TmTJBr6r_200x200.jpg",
        "created_at_shanghai": "2026-11-06 01:40:05",
        "created_at_utc": "2026-11-05T17:40:05.000Z",
        "id": "2118397958781612411",
        "images": [
          "https://pbs.twimg.com/amplify_video_thumb/2118396829159006208/img/exK4C5Pbjg8NnK3v.jpg"
        ],
        "media": [
          {
            "duration": 393.233,
            "height": 1920,
            "thumbnail_url": "https://pbs.twimg.com/amplify_video_thumb/2118396829159006208/img/exK4C5Pbjg8NnK3v.jpg",
            "type": "video",
            "url": "https://video.twimg.com/amplify_video/2118396829159006208/vid/avc1/1080x1920/mBmqz6c0FXpi6cUE.mp4?tag=29",
            "width": 1080
          }
        ],
        "name": "Rupert Lowe MP",
        "text": "I invited @EvaVlaar to Britain to attend a Restore Britain event - the Home Office has not allowed that to happen. My thoughts on a dark day for free speech in our country...",
        "url": "https://x.com/RupertLowe10/status/2118397958781612411",
        "verified": true,
        "verified_type": "government"
      },
      "retweet": null,
      "reply_to": "",
      "engagement": {
        "bookmarks": 100,
