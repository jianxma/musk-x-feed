      "type": "引用",
      "type_label": "引用",
      "text": "It means entire countries and cultures will go extinct forever",
      "quote": {
        "author": "IterIntellectus",
        "avatar": "https://pbs.twimg.com/profile_images/2009602429478633472/8lMkYuep_200x200.jpg",
        "created_at_shanghai": "2026-10-27 00:17:15",
