      "text": "Maybe more than 10GW",
      "quote": {
        "author": "bg2clips",
        "avatar": "https://pbs.twimg.com/profile_images/1917796804264857600/kplN8Vg7_200x200.jpg",
        "created_at_shanghai": "2026-10-16 05:12:20",
