        "id": "2110758804035871007",
        "images": [],
        "media": [],
        "name": "Konstantin Othmer",
        "text": "@elonmusk My original Roadster still runs 20 years later. Battery still fine! Reserved the new one first in 2013. Thirteen years later, \"beyond imagination\" finally gets a date.",
        "url": "https://x.com/konikaze/status/2110758804035871007",
        "verified": true,
        "verified_type": "individual"
      },
