      "text": "Impressive",
      "quote": {
        "author": "sundarpichai",
        "avatar": "https://pbs.twimg.com/profile_images/2051799620062429184/AL8CoAUG_200x200.jpg",
        "created_at_shanghai": "2026-10-29 01:01:48",
