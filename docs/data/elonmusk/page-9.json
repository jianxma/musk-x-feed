        "media": [
          {
            "height": 923,
            "type": "photo",
            "url": "https://pbs.twimg.com/media/HWNnNeYaoAAeW13.jpg?name=small",
            "width": 923
          }
        ],
        "name": "DogeDesigner",
        "text": "BREAKING: Starlink helped Japan’s ZIPAIR grow passenger revenue 12.3% YoY.\n\nJapan Airlines (JAL) says @Starlink improved ZIPAIR’s onboard experience and helped drive revenue growth alongside flexible pricing. \n\nZIPAIR became Asia’s first airline with Starlink across its entire fleet in May. April–September passenger revenue reached ¥42.9 billion, while seat occupancy jumped from 73.7% to 87.8%.",
        "url": "https://x.com/cb_doge/status/2117649738623496227",
