      "text": "Starlink grows customers for airlines",
      "quote": {
        "author": "cb_doge",
        "avatar": "https://pbs.twimg.com/profile_images/1498070100393754625/C2V-fbll_200x200.jpg",
        "created_at_shanghai": "2026-11-04 00:06:56",
