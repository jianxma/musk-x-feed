      "type": "引用",
      "type_label": "引用",
      "text": "Try Grok @Bot!",
      "quote": {
        "author": "Saboo_Shubham_",
        "avatar": "https://pbs.twimg.com/profile_images/2011150989668270080/wQ4NP39W_200x200.jpg",
