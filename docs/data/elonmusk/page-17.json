    {
      "id": "2118050563145510979",
      "author": "elonmusk",
      "author_name": "Elon Musk",
      "author_avatar": "https://pbs.twimg.com/profile_images/2053244804520427520/m8mdWZCG_200x200.jpg",
      "author_verified": true,
      "author_verified_type": "individual",
      "created_at_utc": "2026-11-04T18:39:40.000Z",
      "created_at_shanghai": "2026-11-05 02:39:40",
      "type": "转发",
      "type_label": "转发",
      "text": "How much usage does a Grok Bot phone call take?\nSo I checked.\n\nMy bot just called an EV charger installer for a quote. 85 seconds on the phone.\n\nUsage before: 5.8%\nUsage after: 6.0%\n\nThat's 0.2% for a real call I didn't have to make myself.",
      "quote": null,
