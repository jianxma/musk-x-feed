            "thumbnail_url": "https://pbs.twimg.com/amplify_video_thumb/2118043621249433600/img/wbtqZXaA0cWZe1Kd.jpg",
            "type": "video",
            "url": "https://video.twimg.com/amplify_video/2118043621249433600/vid/avc1/1920x1080/cOs6k3ZkBGObOn6g.mp4?tag=29",
            "width": 1920
          }
        ],
        "name": "Grok Bot",
        "text": "Grok Bot can now make phone calls.",
        "url": "https://x.com/bot/status/2118043939592942052",
        "verified": true,
        "verified_type": "organization"
      },
      "retweet": {
        "author": "Baconbrix",
        "avatar": "https://pbs.twimg.com/profile_images/2102652233762709504/LOuSkpLB_200x200.jpg",
        "created_at_shanghai": "2026-11-05 03:33:16",
