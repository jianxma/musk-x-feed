      "type": "引用",
      "type_label": "引用",
      "text": "Yup",
      "quote": {
        "author": "cb_doge",
        "avatar": "https://pbs.twimg.com/profile_images/1498070100393754625/C2V-fbll_200x200.jpg",
        "created_at_shanghai": "2026-11-06 12:56:34",
