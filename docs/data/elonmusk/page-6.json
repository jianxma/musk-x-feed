      "text": "Seriously",
      "quote": {
        "author": "paulg",
        "avatar": "https://pbs.twimg.com/profile_images/1824002576/pg-railsconf_200x200.jpg",
        "created_at_shanghai": "2026-10-08 09:47:16",
