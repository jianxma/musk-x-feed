      "type": "引用",
      "type_label": "引用",
      "text": "True",
      "quote": {
        "author": "christopherrufo",
        "avatar": "https://pbs.twimg.com/profile_images/1971986671928541184/nwHqdQB0_200x200.jpg",
        "created_at_shanghai": "2026-09-23 22:20:59",
        "created_at_utc": "2026-09-23T14:20:59.000Z",
        "id": "2102765171479568630",
