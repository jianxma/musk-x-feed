        ],
        "media": [
          {
            "duration": 95.291,
            "height": 2160,
            "thumbnail_url": "https://pbs.twimg.com/amplify_video_thumb/2102764062316843008/img/w9HYSerOeDGRd_SP.jpg",
            "type": "video",
            "url": "https://video.twimg.com/amplify_video/2102764062316843008/vid/avc1/3840x2160/I_iD0f1qCLljNAYX.mp4?tag=29",
            "width": 3840
          }
        ],
        "name": "Christopher Rufo",
        "text": "EXCLUSIVE: California has created a shadow welfare system for illegal aliens. Free housing, cash, healthcare, food, phones, college tuition, even car insurance—costing taxpayers more than $10 billion per year.\n\nWe went inside the system and exposed it all.",
        "url": "https://x.com/christopherrufo/status/2102765171479568630",
