      "text": "Starlink is a gamechanger",
      "quote": {
        "author": "XFreeze",
        "avatar": "https://pbs.twimg.com/profile_images/1876785200010539008/2_HFJjq9_200x200.jpg",
        "created_at_shanghai": "2026-11-16 00:09:33",
