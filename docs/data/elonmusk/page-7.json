      "type": "引用",
      "type_label": "引用",
      "text": "Try the latest Grok @Bot!",
      "quote": {
        "author": "ericzakariasson",
        "avatar": "https://pbs.twimg.com/profile_images/1841151626456801283/HnXqy3TQ_200x200.jpg",
