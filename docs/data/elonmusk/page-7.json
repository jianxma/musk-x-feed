      "type": "引用",
      "type_label": "引用",
      "text": "Good questions",
      "quote": {
        "author": "XFreeze",
        "avatar": "https://pbs.twimg.com/profile_images/1876785200010539008/2_HFJjq9_200x200.jpg",
        "created_at_shanghai": "2026-10-26 00:01:56",
