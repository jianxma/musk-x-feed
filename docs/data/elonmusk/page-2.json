      "text": "Try out Grok @Bot!",
      "quote": {
        "author": "Texas_Twins_Dad",
        "avatar": "https://pbs.twimg.com/profile_images/2001129830213967874/zFqUgDus_200x200.jpg",
        "created_at_shanghai": "2026-10-17 13:56:43",
