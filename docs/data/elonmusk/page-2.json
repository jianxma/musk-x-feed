      "text": "🇻🇪 Starlink in Venezuela! 🇻🇪",
      "quote": {
        "author": "cb_doge",
        "avatar": "https://pbs.twimg.com/profile_images/1498070100393754625/C2V-fbll_200x200.jpg",
        "created_at_shanghai": "2026-10-10 04:59:13",
