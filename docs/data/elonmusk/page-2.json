            "url": "https://pbs.twimg.com/media/HTy3FKIW4AAzgnI.jpg?name=small",
            "width": 959
          }
        ],
        "name": "Forbes",
        "text": "Elon Musk said he would rename his SpaceXAI company to “SpaceXSI” after President Donald Trump pushed for artificial intelligence to rebrand as “super intelligence.”\nhttps://go.forbes.com/XOh6_8",
        "url": "https://x.com/Forbes/status/2106760026241048826",
        "verified": true,
        "verified_type": "organization"
