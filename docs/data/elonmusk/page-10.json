      "text": "Terafab is moving fast",
      "quote": {
        "author": "herbertong",
        "avatar": "https://pbs.twimg.com/profile_images/2006760109674999809/DCuTxqri_200x200.jpg",
        "created_at_shanghai": "2026-11-06 09:55:00",
