      "type": "引用",
      "type_label": "引用",
      "text": "Three booster catches and a ship",
      "quote": {
        "author": "cb_doge",
        "avatar": "https://pbs.twimg.com/profile_images/1498070100393754625/C2V-fbll_200x200.jpg",
        "created_at_shanghai": "2026-11-15 05:39:36",
        "created_at_utc": "2026-11-14T21:39:36.000Z",
        "id": "2121719723805258178",
        "images": [
          "https://pbs.twimg.com/amplify_video_thumb/2121719661121421312/img/TP7WgAvqXQYq_mLy.jpg"
        ],
        "media": [
          {
            "duration": 35.446,
            "height": 1350,
            "thumbnail_url": "https://pbs.twimg.com/amplify_video_thumb/2121719661121421312/img/TP7WgAvqXQYq_mLy.jpg",
            "type": "video",
            "url": "https://video.twimg.com/amplify_video/2121719661121421312/vid/avc1/1080x1350/q3Wi7xLvvv53rlDz.mp4?tag=29",
            "width": 1080
          }
        ],
        "name": "DogeDesigner",
        "text": "SpaceX keeps making history. \n\n• Oct 13, 2024: First booster catch\n• Jan 16, 2025: Second booster catch\n• Mar 6, 2025: Third booster catch\n• Nov 14, 2026: First Starship catch",
        "url": "https://x.com/cb_doge/status/2121719723805258178",
        "verified": true,
        "verified_type": "individual"
      },
