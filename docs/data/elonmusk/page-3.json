    {
      "id": "2121755853766504842",
      "author": "elonmusk",
      "author_name": "Elon Musk",
      "author_avatar": "https://pbs.twimg.com/profile_images/2053244804520427520/m8mdWZCG_200x200.jpg",
      "author_verified": true,
      "author_verified_type": "individual",
      "created_at_utc": "2026-11-15T00:03:10.000Z",
      "created_at_shanghai": "2026-11-15 08:03:10",
      "type": "转发",
      "type_label": "转发",
      "text": "The holy grail of rocketry has just been achieved. This is an inflection point in human history that will unlock the solar system for humankind. Congrats to everyone on Planet Earth!!! ❤️",
