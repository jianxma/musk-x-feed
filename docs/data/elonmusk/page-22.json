        "media": [
          {
            "height": 2048,
            "type": "photo",
            "url": "https://pbs.twimg.com/media/HWCe1i5a0AAk7g5.jpg?name=small",
            "width": 2048
          }
        ],
        "name": "DogeDesigner",
        "text": "Starlink became a lifeline for rescuers in England. \n\nA walker fell down a steep bank into a hornet’s nest near Wetheral.\n\nThe rescue team had no mobile signal where they were training. Starlink in their control vehicle got the emergency call through.\n\nRescuers reached the walker, used ropes to lift them up the bank on a stretcher, and carried them to an ambulance.\n\nThis is the life-saving power of Starlink. Keeping rescuers connected means people in danger can get the help they urgently need.",
        "url": "https://x.com/cb_doge/status/2116866478402338932",
        "verified": true,
        "verified_type": "individual"
      },
